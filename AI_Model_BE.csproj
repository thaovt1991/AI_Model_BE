<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AI_Model_BE.http" />
  </ItemGroup>

  <ItemGroup>
    <!-- LLamaSharp: wrapper .NET cho llama.cpp, dùng để nạp và chạy model LLM local định dạng .gguf. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <!-- LLamaSharp.Backend.Cpu: runtime CPU cho LLamaSharp, phù hợp demo offline không cần GPU. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- Microsoft.ML: ML.NET, dùng cho học máy truyền thống như regression/classification trong .NET. -->
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="5.0.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <!-- DocumentFormat.OpenXml: đọc Word (.docx) và Excel (.xlsx) — file Office thực chất là ZIP chứa XML. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- UglyToad.PdfPig: trích xuất text từ PDF (text layer), không cần Adobe Reader. -->
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <!-- Swashbuckle: Swagger UI — kiểm tra API Backend đang chạy và thử endpoint. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Lotto\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
