{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "PolicyName": "SpaClients",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "http://localhost:8099",
      "http://127.0.0.1:8099",
      "http://192.168.1.200:8099"
    ]
  },
  "Llama": {
    // Đường dẫn file model .gguf — Meta-Llama-3-8B (chất lượng cao, chậm trên CPU)
    "ModelPath": "D:\\Job\\Model AI\\Model AI Local\\Meta-Llama-3-8B-Instruct-Q4_K_M.gguf", //chạy local
    //"ModelPath": "C:\\inetpub\\wwwroot\\Models\\Meta-Llama-3-8B-Instruct-Q4_K_M.gguf", //chạy IIS
    // Model nhẹ hơn, nhanh hơn trên CPU — bỏ // ở dòng trên và // ở dòng dưới để đổi model
    //"ModelPath": "D:\\Job\\Model AI\\Model AI Local\\Phi-3-mini-4k-instruct-q4.gguf",
    // Số token ngữ cảnh tối đa (càng lớn càng tốn RAM)
    "ContextSize": 2048,
    // 0 = chạy CPU; nếu có GPU NVIDIA → đặt 35 hoặc -1 và cài LLamaSharp.Backend.Cuda
    "GpuLayerCount": 0,
    // Trần token khi giải thích. Câu thường dùng BriefMaxTokens (ngắn = nhanh hơn trên CPU)
    "MaxTokens": 160,
    "BriefMaxTokens": 96,
    "ExplainMaxTokens": 220,
    // Nhiệt độ thấp: bớt bịa, bớt lặp. 0.2 = chắc hơn, 0.6 = thoáng hơn
    "Temperature": 0.35,
    "TopK": 40,
    "TopP": 0.9,
    "MinP": 0.05,
    "RepeatPenalty": 1.12,
    "FrequencyPenalty": 0.2,
    "PresencePenalty": 0.1,
    "PenaltyCount": 128,
    // Số luồng CPU (0 = dùng hết core máy)
    "Threads": 0,
    // true = nạp model ngay khi Backend start (chat đầu nhanh hơn, nhưng start BE lâu hơn)
    "WarmUpOnStart": true,
    // Số lượt hội thoại (user+assistant) nhớ trong mỗi phiên chat
    "MaxHistoryTurns": 4
  },
  "ChatMemory": {
    // true = lưu hội thoại vào thư mục ChatMemory/ trên đĩa (không mất khi restart Backend)
    "PersistToDisk": true,
    // Số lượt tối đa lưu trên đĩa (vĩnh viễn theo profileId trình duyệt)
    "MaxStoredTurns": 100,
    // Số lượt gần nhất đưa vào prompt mỗi lần chat (ít hơn = prefill CPU nhanh hơn)
    "MaxHistoryTurns": 4
  },
  "Documents": {
    // Mỗi đoạn text dài bao nhiêu ký tự khi chia chunk
    "ChunkSize": 600,
    "ChunkOverlap": 80,
    // Lấy tối đa bao nhiêu đoạn liên quan gửi vào LLM khi chat
    "MaxChunksPerQuery": 2,
    // Giới hạn tổng ký tự context tài liệu — tránh prompt quá dài làm LLM chậm
    "MaxContextChars": 1600,
    // Hybrid RAG: trọng số embedding (semantic) vs BM25 (từ khóa)
    "EmbeddingWeight": 0.55,
    "Bm25Weight": 0.45
  },
  "WebResearch": {
    // ========== RESEARCH MẠNG (không cần API key) ==========
    // true = cho phép AI tìm DuckDuckGo + Wikipedia + đọc tóm tắt trang
    "Enabled": true,
    // true = tự bật research khi câu hỏi có từ khóa thời sự / tra cứu (khi UI không ép tắt)
    "AutoDetect": true,
    // Số kết quả tối đa đưa vào prompt
    "MaxResults": 3,
    // Độ dài mỗi snippet / tóm tắt
    "MaxSnippetChars": 280,
    // Giới hạn tổng context web gửi vào LLM
    "MaxContextChars": 1800,
    // false = chỉ dùng snippet (nhanh). true = tải thêm HTML, chậm và dễ nhiễu
    "FetchPageContent": false,
    "MaxPagesToFetch": 1,
    // Timeout mỗi request HTTP (giây)
    "TimeoutSeconds": 8,
    // Số token trả lời khi có kết quả web
    "MaxTokens": 180
  },
  "DeepResearch": {
    // ========== DEEP RESEARCH (nhiều góc độ) ==========
    // true = cho phép chế độ nghiên cứu sâu từ UI
    "Enabled": true,
    // Số truy vấn phụ tối đa sinh từ 1 câu hỏi (chạy tối đa 2 luồng)
    "MaxSubQueries": 2,
    // Số nguồn giữ lại sau khi gộp + dedupe
    "MaxSources": 5,
    // Giới hạn context đưa vào LLM
    "MaxContextChars": 2800,
    // Token trả lời khi deep research
    "MaxTokens": 240
  },

  "Learning": {
    // ========== HỌC MODEL NGẦM (LoRA) — giải thích nhanh ==========
    // Giai đoạn 1 (mặc định): CollectData=true, Enabled=false → chỉ GHI chat vào Learning/dataset.jsonl
    // Giai đoạn 2 (khi sẵn sàng): Enabled=true → train file adapter nhỏ .gguf, model chat dùng thêm kiến thức đó
    // Khác "nhớ hội thoại" (ChatMemory): nhớ = đọc lại lịch sử trong prompt; LoRA = sửa nhẹ bộ não model

    // false = KHÔNG train (an toàn, không tốn CPU). true = train LoRA nền khi đủ mẫu + máy rảnh
    "Enabled": false,
    // true = mỗi lượt chat lưu cặp hỏi/đáp làm dữ liệu học (user không thấy gì trên UI)
    "CollectData": true,
    // Worker nền kiểm tra / flush dataset mỗi N phút
    "CheckIntervalMinutes": 15,
    // Cần ít nhất N cuộc hỏi đáp trước khi train có ích
    "MinSamplesForTraining": 20,
    // Mỗi lần train lấy tối đa N mẫu gần nhất (train 8B trên CPU rất lâu nếu quá nhiều)
    "MaxSamplesPerTrain": 200,
    // Sau lượt chat cuối, chờ N phút mới train — tránh lag khi đang dùng chat
    "IdleMinutesAfterLastChat": 30,
    // File adapter LoRA sau train — LLamaSharp tự nạp khi chat
    "AdapterPath": "Learning/Adapters/latest.gguf",
    // Độ mạnh adapter: 1.0 = áp dụng đủ, 0.5 = ảnh hưởng nhẹ hơn lên câu trả lời
    "AdapterScale": 1.0,
    // Công cụ train (chỉ chạy khi Enabled = true). Cần cài Python trên máy chạy Backend
    "PythonPath": "python",
    "TrainScriptPath": "Learning/train_lora.py",
    // Model HuggingFace tương ứng file .gguf (một số model cần đăng nhập HF)
    "HuggingFaceModelId": "meta-llama/Meta-Llama-3-8B-Instruct",
    // Tuỳ chọn: đường dẫn llama.cpp CLI để finetune trực tiếp từ file .gguf
    "LlamaCppBinPath": ""
  },
  "MinhNgoc": {
    // ========== CÀO DỮ LIỆU MINH NGỌC — giảm tải server đích ==========
    // true = cho phép HTTP tới minhngoc.net.vn; false = chỉ dùng file local Data/Lotto/
    "ScrapingEnabled": true,
    // Khoảng cách tối thiểu giữa hai request (ms) — tuần tự, không song song
    "RequestDelayMs": 800,
    // Cache HTML theo URL (phút) — tránh gọi lại cùng URL khi F5 hoặc đổi tab
    "CacheMinutes": 30,
    // Số request theo ngày tối đa mỗi lần gom lịch sử (ngoài trang list) — 50 khớp mục tiêu MN/MT
    "MaxHistoryFetchesPerRun": 50,
    // Số lần thử URL khi lấy kết quả mới nhất XSMB (theo ngày)
    "MaxLatestProbeAttempts": 3,
    // true = khi bấm Dự đoán, dùng file local nếu đủ 20+ kỳ (không áp dụng cho hiển thị kết quả mới nhất)
    "PreferLocalDataFirst": true
  },
  "Coin": {
    // ========== DỰ ĐOÁN COIN — Ensemble LightGBM + SSA ==========
    // Binance public API (không cần API key)
    "BinanceBaseUrl": "https://api.binance.com",
    // Cache nến (phút) — tránh spam Binance khi F5
    "CacheMinutes": 2,
    // Cache danh mục coin (giờ) — exchangeInfo đổi ít
    "CatalogCacheHours": 6,
    // Số nến mặc định khi UI không gửi Lookback
    "DefaultLookback": 500,
    // Trọng số ensemble (sẽ được chuẩn hóa)
    "LightGbmWeight": 0.70,
    "SsaWeight": 0.30,
    // |change%| dưới ngưỡng này → "Đi ngang"
    "FlatThresholdPct": 0.15
  }
}
