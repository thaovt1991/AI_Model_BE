{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "PolicyName": "SpaClients",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "http://localhost:8099",
      "http://127.0.0.1:8099",
      "http://192.168.1.200:8099"
    ]
  },
  "Llama": {
    // Đường dẫn file model .gguf — Meta-Llama-3-8B (chất lượng cao, chậm trên CPU)
    "ModelPath": "D:\\Job\\Model AI\\Model AI Local\\Meta-Llama-3-8B-Instruct-Q4_K_M.gguf", //chạy local
    //"ModelPath": "C:\\inetpub\\wwwroot\\Models\\Meta-Llama-3-8B-Instruct-Q4_K_M.gguf", //chạy IIS
    // Model nhẹ hơn, nhanh hơn trên CPU — bỏ // ở dòng trên và // ở dòng dưới để đổi model
    //"ModelPath": "D:\\Job\\Model AI\\Model AI Local\\Phi-3-mini-4k-instruct-q4.gguf",
    // Số token ngữ cảnh tối đa (càng lớn càng tốn RAM)
    "ContextSize": 2048,
    // 0 = chạy CPU; nếu có GPU NVIDIA → đặt 35 hoặc -1 và cài LLamaSharp.Backend.Cuda
    "GpuLayerCount": 0,
    // Giới hạn độ dài câu trả lời — giảm xuống 128 nếu muốn nhanh hơn
    "MaxTokens": 256,
    // Số luồng CPU (0 = dùng hết core máy)
    "Threads": 0,
    // true = nạp model ngay khi Backend start (chat đầu nhanh hơn, nhưng start BE lâu hơn)
    "WarmUpOnStart": true,
    // Số lượt hội thoại (user+assistant) nhớ trong mỗi phiên chat
    "MaxHistoryTurns": 8
  },
  "ChatMemory": {
    // true = lưu hội thoại vào thư mục ChatMemory/ trên đĩa (không mất khi restart Backend)
    "PersistToDisk": true,
    // Số lượt tối đa lưu trên đĩa (vĩnh viễn theo profileId trình duyệt)
    "MaxStoredTurns": 100,
    // Số lượt gần nhất đưa vào prompt mỗi lần chat (giới hạn bởi ContextSize)
    "MaxHistoryTurns": 8
  },
  "Documents": {
    // Mỗi đoạn text dài bao nhiêu ký tự khi chia chunk
    "ChunkSize": 600,
    "ChunkOverlap": 80,
    // Lấy tối đa bao nhiêu đoạn liên quan gửi vào LLM khi chat
    "MaxChunksPerQuery": 3,
    // Giới hạn tổng ký tự context tài liệu — tránh prompt quá dài làm LLM chậm
    "MaxContextChars": 2400
  },
  "Learning": {
    // ========== HỌC MODEL NGẦM (LoRA) — giải thích nhanh ==========
    // Giai đoạn 1 (mặc định): CollectData=true, Enabled=false → chỉ GHI chat vào Learning/dataset.jsonl
    // Giai đoạn 2 (khi sẵn sàng): Enabled=true → train file adapter nhỏ .gguf, model chat dùng thêm kiến thức đó
    // Khác "nhớ hội thoại" (ChatMemory): nhớ = đọc lại lịch sử trong prompt; LoRA = sửa nhẹ bộ não model

    // false = KHÔNG train (an toàn, không tốn CPU). true = train LoRA nền khi đủ mẫu + máy rảnh
    "Enabled": false,
    // true = mỗi lượt chat lưu cặp hỏi/đáp làm dữ liệu học (user không thấy gì trên UI)
    "CollectData": true,
    // Worker nền kiểm tra / flush dataset mỗi N phút
    "CheckIntervalMinutes": 15,
    // Cần ít nhất N cuộc hỏi đáp trước khi train có ích
    "MinSamplesForTraining": 20,
    // Mỗi lần train lấy tối đa N mẫu gần nhất (train 8B trên CPU rất lâu nếu quá nhiều)
    "MaxSamplesPerTrain": 200,
    // Sau lượt chat cuối, chờ N phút mới train — tránh lag khi đang dùng chat
    "IdleMinutesAfterLastChat": 30,
    // File adapter LoRA sau train — LLamaSharp tự nạp khi chat
    "AdapterPath": "Learning/Adapters/latest.gguf",
    // Độ mạnh adapter: 1.0 = áp dụng đủ, 0.5 = ảnh hưởng nhẹ hơn lên câu trả lời
    "AdapterScale": 1.0,
    // Công cụ train (chỉ chạy khi Enabled = true). Cần cài Python trên máy chạy Backend
    "PythonPath": "python",
    "TrainScriptPath": "Learning/train_lora.py",
    // Model HuggingFace tương ứng file .gguf (một số model cần đăng nhập HF)
    "HuggingFaceModelId": "meta-llama/Meta-Llama-3-8B-Instruct",
    // Tuỳ chọn: đường dẫn llama.cpp CLI để finetune trực tiếp từ file .gguf
    "LlamaCppBinPath": ""
  }
}
